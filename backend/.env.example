# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env for local development
#
# File usage:
# - backend/.env.example     -> onboarding template (committed)
# - backend/.env             -> local development runtime (gitignored)
# - backend/.env.test.example-> test template (committed)
# - backend/.env.test        -> local test runtime (gitignored)
# - Production values        -> hosting provider secret manager only

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trey_dev

# JWT Authentication
JWT_SECRET=23932a76f03e359911b06d53c78f7e559fb62e90f866df2f0eb2be60330e72cd

# Google SSO Configuration
GOOGLE_CLIENT_ID=dev-client-id-1234567890.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dev-google-secret-local-8f7b3d2c1a
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limit Controls
# Production-safe defaults are applied if omitted.
# RATE_LIMIT_API_MAX=100
# RATE_LIMIT_AUTH_MAX=5

# File Upload
UPLOAD_DIR=./uploads

# Storage Provider
# local (default): store evidence files on local disk
# s3: use S3-compatible object storage (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=local

# S3/R2 Configuration (required when STORAGE_PROVIDER=s3)
# S3_BUCKET=trey-evidence
# S3_REGION=auto
# S3_ENDPOINT=https://accountid.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=r2accesskeyid
# S3_SECRET_ACCESS_KEY=r2secretaccesskey
# S3_FORCE_PATH_STYLE=false

# Email Configuration (for SLA Alerts)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=local
SMTP_PASSWORD=local
SMTP_FROM=noreply@compliance-system.com

# Timezone (for cron jobs)
TZ=Asia/Kolkata

# Development Options
RUN_ALERTS_ON_STARTUP=false

# Logging and Monitoring
# LOG_LEVEL=debug|info|warn|error
LOG_LEVEL=debug

# Optional Sentry error monitoring
# SENTRY_DSN=https://devkey@devorg.ingest.sentry.io/123456
# SENTRY_TRACES_SAMPLE_RATE=0.1
