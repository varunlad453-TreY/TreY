{
  "name": "compliance-execution-backend",
  "version": "1.0.0",
  "description": "System of Record for Compliance Execution - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "nodemon --exec ts-node src/index.ts",
    "migrate": "ts-node src/scripts/migrate.ts",
    "migrate:test": "ts-node -r dotenv/config src/scripts/migrate.ts dotenv_config_path=.env.test",
    "validate:env": "ts-node src/scripts/validateEnv.ts",
    "validate:db": "ts-node src/scripts/validateDatabaseSetup.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:test": "ts-node -r dotenv/config src/scripts/seed.ts dotenv_config_path=.env.test",
    "test:prepare": "npm run migrate:test && npm run seed:test",
    "validate:phase4": "ts-node src/scripts/validatePhase4.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@sentry/node": "^8.36.0",
    "archiver": "^6.0.1",
    "bcrypt": "^5.1.1",
    "compliance-execution-system": "file:..",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
